# VIDS .gitignore — keep repo lean; weights via Releases (Git LFS or attachments)
# college submission report (private) - never commit
Report/
# personal submission details for the report generator (private)
Report/details.json
# unrelated drop folder (trading notes, other students' files) - never commit
Report/opencode/
dataset/
model/*.pth
model/presets/
Software/dist/
Software/build/
Software/exe_env/
Software/test_install/
Software/*.exe
__pycache__/
*.pyc
webapp/static/audio/*.png
webapp/static/audio/*.wav
webapp/static/audio/*.mp3
webapp/static/audio/*.webm
*.log
